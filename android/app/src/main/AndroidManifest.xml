<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <queries>
        <package android:name="com.termux" />
        <package android:name="com.termux.api" />
    </queries>

    <application
        android:name=".core.System2Application"
        android:allowBackup="true"
        android:icon="@mipmap/ic_system2"
        android:label="SYSTEM2 MOBILE"
        android:roundIcon="@mipmap/ic_system2_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.System2"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.System2"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Termux RUN_COMMAND result receiver -->
        <receiver
            android:name=".bridge.TermuxRunCommandReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.termux.app.RunCommandService.ACTION_RESULT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
